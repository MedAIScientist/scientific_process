# 🔑 API Keys Configuration for AI-Powered Scientific Paper Generator
# 
# Copy this file to .env and fill in your real API keys
# cp config_example.env .env

# ✅ REQUIRED - OpenAI API Key 
# Get your key at: https://platform.openai.com/api-keys
# Approximate cost: $1-3 per generated paper
OPENAI_API_KEY=sk-your_openai_key_here

# 🔍 OPTIONAL - Semantic Scholar API Key
# Improves academic reference quality
# Get your key at: https://www.semanticscholar.org/product/api
# Free with rate limits
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_key_here

# 📊 Optional configuration
# OpenAI model to use (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Temperature for generation (0.0-1.0, default: 0.3)
# OPENAI_TEMPERATURE=0.3

# Maximum number of references to search (default: 20)
# MAX_REFERENCES=20 